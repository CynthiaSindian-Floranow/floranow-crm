// ERP ↔ CRM sync runner — one job, two modes, three ways to trigger.
//
//   Job A ("sync")   — provisioning: qualified leads with a debtor number
//                      become Companies; leads flip to Converted.
//   Job B ("mirror") — nightly refresh of the mirrored commercial fields
//                      + the lastSyncAt freshness stamp.
//
// Triggers:
//   1. Cron (below)            — runs Job B nightly with the default params.
//   2. "Build with Parameters" — support/ops run Job A on demand after an
//                                import, or a one-off mirror.
//   3. Remote trigger URL      — enable "Trigger builds remotely" on this job
//                                and a Twenty workflow button in the CRM can
//                                POST to .../buildWithParameters?token=…
//                                (see README, "Manual trigger from the CRM").
//
// Credentials expected in Jenkins (string credentials):
//   twenty-dev-api-key   — CRM dev workspace API key
//   erp-dev-api-key      — FLORANOW_API_SHARED_KEY of the dev ERP
// Prod equivalents get added at go-live; until then the CLI itself refuses
// any remote other than dev, so a mis-set parameter cannot touch prod.

pipeline {
  agent any

  options {
    timestamps()
    disableConcurrentBuilds()
  }

  parameters {
    choice(name: 'JOB', choices: ['mirror', 'sync'],
           description: 'mirror = Job B (nightly refresh) · sync = Job A (provision leads)')
    choice(name: 'MODE', choices: ['apply', 'dry-run'],
           description: 'dry-run prints the plan without writing')
    choice(name: 'REMOTE', choices: ['dev'],
           description: 'Target environment (prod is unlocked at go-live)')
  }

  // Scheduled runs use the default parameter values → nightly Job B apply.
  triggers {
    cron('H 2 * * *')
  }

  environment {
    APP_DIR        = 'packages/twenty-apps/floranow/erp-sync'
    TWENTY_DEV_URL = 'https://crm-dev.floranow.com'
    ERP_DEV_URL    = 'https://erp-dev.floranow.com'
  }

  stages {
    stage('Install') {
      steps {
        dir(env.APP_DIR) {
          sh '''
            corepack enable
            yarn install --immutable
          '''
        }
      }
    }

    stage('Run') {
      steps {
        withCredentials([
          string(credentialsId: 'twenty-dev-api-key', variable: 'TWENTY_DEV_API_KEY'),
          string(credentialsId: 'erp-dev-api-key', variable: 'ERP_DEV_API_KEY')
        ]) {
          dir(env.APP_DIR) {
            sh "yarn ${params.JOB} --remote ${params.REMOTE} --${params.MODE}"
          }
        }
      }
    }
  }
}
