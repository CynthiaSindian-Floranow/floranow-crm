// Lane 3 — RECORDS (Phase 3). Mirrors each Company's standing orders, order
// events and incidents as CRM records. Heavier and diff-based. Runs twice a
// day: 12:30 and 19:30 UAE — 30 minutes behind the Mirror lane so the two
// never run at once.
//
// Dev only. Credentials: twenty-dev-api-key, erp-dev-api-key, sync-slack-webhook

pipeline {
  agent any

  options {
    timestamps()
    disableConcurrentBuilds()
  }

  triggers {
    cron('''TZ=Asia/Dubai
30 12,19 * * *''')
  }

  environment {
    APP_DIR        = 'packages/twenty-apps/floranow/erp-sync'
    LANE           = 'Records'
    TWENTY_DEV_URL = 'https://crm-dev.floranow.com'
    ERP_DEV_URL    = 'https://erp-dev.floranow.com'
  }

  stages {
    stage('Install') {
      steps {
        dir(env.APP_DIR) {
          sh 'corepack enable && yarn install --immutable'
        }
      }
    }

    stage('Run') {
      steps {
        withCredentials([
          string(credentialsId: 'twenty-dev-api-key', variable: 'TWENTY_DEV_API_KEY'),
          string(credentialsId: 'erp-dev-api-key', variable: 'ERP_DEV_API_KEY')
        ]) {
          dir(env.APP_DIR) {
            // All three child types in sequence; each appends its summary so
            // one Slack message covers the whole lane. pipefail + '|| exit'
            // make any failing step fail the build.
            sh '''set -o pipefail
              rm -f run.log
              yarn standing-orders:dev:apply 2>&1 | tee -a run.log
              yarn order-events:dev:apply    2>&1 | tee -a run.log
              yarn incidents:dev:apply       2>&1 | tee -a run.log'''
          }
        }
      }
    }
  }

  post {
    always {
      script {
        notifySlack()
      }
    }
  }
}

void notifySlack() {
  def logFile = "${env.APP_DIR}/run.log"
  // Only the summary lines, so one message covers all three child types.
  def tail = '(no output captured)'
  if (fileExists(logFile)) {
    def summary = readFile(logFile).readLines().findAll { it.contains('compan(ies)') }
    tail = (summary ?: readFile(logFile).readLines().takeRight(20)).join('\n')
  }
  def ok = currentBuild.currentResult == 'SUCCESS'
  def header = (ok ? ':white_check_mark:' : '<!here> :x:') +
    " *${env.LANE}* (dev) — ${currentBuild.currentResult}"
  def msg = "${header}\n```${tail}```\n<${env.BUILD_URL}|open build>"
  def esc = msg.replace('\\', '\\\\').replace('"', '\\"').replace('\n', '\\n')
  writeFile file: 'slack.json', text: '{"text":"' + esc + '"}'
  withCredentials([string(credentialsId: 'sync-slack-webhook', variable: 'HOOK')]) {
    sh "curl -sS -X POST -H 'Content-type: application/json' --data @slack.json \"\$HOOK\""
  }
}
